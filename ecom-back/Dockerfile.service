FROM maven:3.9.9-eclipse-temurin-21 AS build

ARG SERVICE_PATH

WORKDIR /workspace

COPY pom.xml pom.xml
COPY common common
COPY api-gateway api-gateway
COPY services services

RUN test -n "$SERVICE_PATH" \
    || (echo "SERVICE_PATH build arg is required. Example: --build-arg SERVICE_PATH=services/auth-service" >&2; exit 1)
RUN test -f "${SERVICE_PATH}/pom.xml" \
    || (echo "No pom.xml found at ${SERVICE_PATH}/pom.xml. Check the SERVICE_PATH build arg." >&2; exit 1)
RUN mvn -f pom.xml -pl "${SERVICE_PATH}" -am -DskipTests package
RUN cp "${SERVICE_PATH}"/target/*.jar /tmp/app.jar

FROM eclipse-temurin:21-jre-jammy

WORKDIR /app

ENV JAVA_OPTS=""

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /tmp/app.jar /app/app.jar

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
